# =============================================================================
# PCS Vector — Streamlit secrets template
# =============================================================================
#
# LOCAL:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# CLOUD:  Streamlit Cloud → App → Settings → Secrets (paste TOML below)
#
# Never commit secrets.toml to git.
# =============================================================================

[stripe]
publishable_key = "pk_test_YOUR_PUBLISHABLE_KEY"
secret_key = "sk_test_YOUR_SECRET_KEY"

[grok]
api_key = "xai-YOUR_GROK_API_KEY"

[pcs_vector]
# REQUIRED after deploying to Streamlit Cloud — use your live app URL exactly:
# https://your-app-name.streamlit.app
app_url = "http://localhost:8501"

# ---------------------------------------------------------------------------
# Email delivery (automatic PDF after payment)
# ---------------------------------------------------------------------------
# Without this section, users can still download PDFs on the report page.
# Copy the same [email] block into Streamlit Cloud → Settings → Secrets.
#
# Gmail example (use a Google App Password, not your normal password):
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords → create "PCS Vector"
#   3. Paste the 16-character app password as smtp_password
#
# [email]
# smtp_host = "smtp.gmail.com"
# smtp_port = 587
# smtp_user = "you@gmail.com"
# smtp_password = "xxxx xxxx xxxx xxxx"
# from_address = "PCS Vector <you@gmail.com>"
# use_tls = true
# reply_to = "you@gmail.com"
#
# Other providers (same shape):
#   Outlook:  smtp.office365.com:587
#   SendGrid: smtp.sendgrid.net:587  (user = "apikey", password = API key)
#   Amazon SES: email-smtp.<region>.amazonaws.com:587
#   Resend:   smtp.resend.com:587     (user = "resend", password = API key)
#
# Spam tip: free @gmail.com often lands in junk. Best fix is a custom domain
# with SPF + DKIM + DMARC (Google Workspace, Resend, SendGrid, Postmark).