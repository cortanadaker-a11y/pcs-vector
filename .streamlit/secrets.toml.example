# =============================================================================
# PCS Vector — Streamlit secrets template
# =============================================================================
#
# LOCAL:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# CLOUD:  Streamlit Cloud → App → Settings → Secrets (paste TOML below)
#
# Never commit secrets.toml to git.
# =============================================================================

[stripe]
publishable_key = "pk_test_YOUR_PUBLISHABLE_KEY"
secret_key = "sk_test_YOUR_SECRET_KEY"

[grok]
api_key = "xai-YOUR_GROK_API_KEY"

[pcs_vector]
# REQUIRED after deploying to Streamlit Cloud — use your live app URL exactly:
# https://your-app-name.streamlit.app
app_url = "http://localhost:8501"

# ---------------------------------------------------------------------------
# Email delivery — Resend (recommended)
# ---------------------------------------------------------------------------
# 1. Create account: https://resend.com
# 2. API Keys → Create API key → copy re_...
# 3. Domains → Add domain → add DNS records (SPF, DKIM, DMARC) → wait until Verified
# 4. From address MUST use that verified domain (not a random @gmail.com)
#
# Testing without a domain: Resend allows from_address = "PCS Vector <onboarding@resend.dev>"
# but you can only send TO your own Resend account email until a domain is verified.
#
# [email]
# smtp_host = "smtp.resend.com"
# smtp_port = 587
# smtp_user = "resend"
# smtp_password = "re_xxxxxxxx"
# from_address = "PCS Vector <reports@yourdomain.com>"
# reply_to = "pcs0vector@gmail.com"
# use_tls = true
#
# Optional: port 465 with implicit SSL
# smtp_port = 465
# use_ssl = true
#
# Gmail (not recommended — often lands in spam):
# smtp_host = "smtp.gmail.com" / App Password / from = same Gmail address
